# Copiar a backend/.env y completar con credenciales reales (nunca commitear el .env real).
# Fuente de valores reales: d:\Code\APP_GUIDE\.env.master (ver CLAUDE.md global).

# --- Base de datos (Aiven MySQL) ---
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=tasar

# --- Auth / JWT ---
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- App ---
APP_NAME=TasAR
APP_VERSION=0.1.0
APP_DEBUG=true
ENVIRONMENT=development
# Solo dev/test: si es true, el lifespan crea el schema con create_all.
# En prod queda false y el schema lo gobierna Alembic.
AUTO_CREATE_SCHEMA=false
PORT=8600
FRONTEND_URL=http://localhost:5600
CORS_ORIGINS=["http://localhost:5600"]

# --- Cloudinary (storage de imágenes) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gemini (IA) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- SMTP (Brevo) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TasAR

# --- Claude CLI (analisis IA vía CLI local) ---
CLAUDE_CMD=claude
CLAUDE_MODEL=claude-sonnet-4-6
